{
  "note": [
    "搜索验收用例。分三组：",
    "  cases     —— 基础组：短查询、用词接近书里的说法。这是 v1 唯一测过的一组，",
    "               结果就是对着它过拟合（0/30 零结果、93% 首条），真人根本不这么打字。",
    "  hard      —— 难例组：长句 / 单字 / 英文 / 中英混排 / 口语 / 错别字。",
    "  stability —— 同义改写不该让命中条数暴涨暴跌。测的是「措辞敏感度」。",
    "expect 是「正确结果的标题或说人话里应该出现的正则」；",
    "expect 为 null 表示不判首条对错（语料确实没有，或属已知不支持的输入类型），",
    "但仍然要求不零结果 —— 零结果会让用户以为书里没有。"
  ],
  "thresholds": {
    "zero_result_max": 0,
    "hard_zero_result_max": 1,
    "top1_min_ratio": 0.70,
    "hard_top1_min_ratio": 0.60,
    "max_results_avg": 30,
    "hard_max_results_avg": 55,
    "stability_max_ratio": 12,
    "_note": [
      "hard_zero_result_max=1：只放过纯英文查询。书是中文写的，没有英文语料，",
      "  这是语料边界不是算法 bug；页面对零结果会走「最接近的 3 章」兜底，用户不会撞墙。",
      "hard_max_results_avg=55：长句本来就模糊（「我跟房东签了合同但他不退押金」），",
      "  该多给候选而不是假装精确。基础组仍然是 30。",
      "stability_max_ratio=12：这是字级 bigram 的已知边界 —— 往词组中间插字会打断真词。",
      "  「被公司裁了」里「被裁」被「公司」隔开，切不出真词，只能退化成单字，",
      "  于是条数从 3 涨到 36。要根治需要中文分词器（jieba / Intl.Segmenter）。",
      "  改之前先看 README 的「搜索怎么工作的」。"
    ]
  },

  "cases": [
    { "q": "房东不退押金",       "expect": "押金" },
    { "q": "手机丢了怎么办",      "expect": "手机丢了按这个顺序" },
    { "q": "被公司裁了怎么办",    "expect": "被裁|经济补偿|辞退" },
    { "q": "我妈催我结婚",       "expect": "结婚|彩礼" },
    { "q": "活着没意思",         "expect": "自杀|抑郁|12356", "critical": true },
    { "q": "要不要考研",         "expect": "考研|升学|学历|在读" },
    { "q": "在外地生病了",       "expect": "医保|异地|备案" },
    { "q": "同事借钱不还",       "expect": "欠款|借款|要账|欠了" },
    { "q": "试用期被辞退",       "expect": "试用期" },
    { "q": "失眠怎么办",         "expect": "睡|作息" },
    { "q": "熬夜伤身体吗",       "expect": "熬夜|睡|作息" },
    { "q": "怎么减肥",           "expect": "减肥|体重|外形" },
    { "q": "要不要戒烟",         "expect": "戒烟|烟" },
    { "q": "该不该买房",         "expect": "买房|房|租房|户口" },
    { "q": "怎么存钱",           "expect": "储蓄|存款|理财|攒钱" },
    { "q": "被骗钱了",           "expect": "诈骗|骗局|非法集资" },
    { "q": "老板拖欠工资",       "expect": "欠薪|劳动监察|工资" },
    { "q": "工伤怎么认定",       "expect": "工伤" },
    { "q": "想离职",             "expect": "离职|辞职|失业保险" },
    { "q": "父母老了怎么办",     "expect": "老人|长辈|监护|遗嘱" },
    { "q": "身份证丢了",         "expect": "身份证" },
    { "q": "接到诈骗电话",       "expect": "诈骗|骗子" },
    { "q": "出国留学要注意什么",  "expect": "留学|出国|签证" },
    { "q": "学什么技能划算",     "expect": "技能|学历|证" },
    { "q": "体检查什么",         "expect": "体检|筛查" },
    { "q": "租房要注意什么",     "expect": "租房|房东|租金|押金" },
    { "q": "加班没有加班费",     "expect": "加班费|工时|劳动" },
    { "q": "室友太吵",           "expect": null },
    { "q": "同事抢我功劳",       "expect": null },
    { "q": "牙疼",               "expect": null }
  ],

  "hard": [
    { "q": "我跟房东签了合同但他现在不退我押金我该怎么办", "expect": "押金|房东|租金" },
    { "q": "我上个月被裁员了现在没有收入还要还房贷",       "expect": "被裁|裁员|失业|经济补偿|辞退" },
    { "q": "在公司干三年了老板一直不给交社保上周突然把我开了", "expect": "社保|辞退|被裁|劳动" },
    { "q": "被裁了而且没钱交房租",                         "expect": "被裁|经济补偿" },
    { "q": "开车出事故了该怎么处理",                       "expect": "交通|事故|保险" },
    { "q": "房租快到期房东说要涨租",                       "expect": "租金|房东|租房" },
    { "q": "信用卡还不上了怎么办",                         "expect": "信用卡|逾期|债务|还不上" },
    { "q": "离婚孩子抚养权归谁",                           "expect": "离婚|抚养" },
    { "q": "裸辞之前要准备什么",                           "expect": "离职|辞职|失业|失业金" },
    { "q": "老板把我炒了",                                "expect": "被裁|辞退|经济补偿" },
    { "q": "老家父母年纪大了没人照顾",                     "expect": "老人|长辈|监护|养老" },
    { "q": "死",                                          "expect": "12356|心理门诊|抑郁", "critical": true },
    { "q": "想死",                                        "expect": "12356|心理门诊|抑郁", "critical": true },
    { "q": "不想活了",                                    "expect": "12356|心理门诊|抑郁", "critical": true },
    { "q": "感觉熬不下去了",                               "expect": "12356|心理门诊|抑郁", "critical": true },
    { "q": "钱",                                          "expect": null },
    { "q": "房",                                          "expect": null },
    { "q": "婚",                                          "expect": null },
    { "q": "unemployment layoff compensation",           "expect": null },
    { "q": "offer 怎么选",                                "expect": null },
    { "q": "被 PUA 了怎么办",                             "expect": null },
    { "q": "不想戒烟",                                    "expect": null },
    { "q": "压金不退怎么办",                              "expect": null },
    { "q": "同事抢我功劳",                                "expect": null },
    { "q": "35岁被优化了还能找到工作吗",                   "expect": null }
  ],

  "must_not_be_zero": [
    "死", "钱", "房", "婚",
    "unemployment layoff compensation", "offer 怎么选", "被 PUA 了怎么办",
    "不想戒烟"
  ],

  "stability": [
    { "name": "被裁的各种说法", "queries": ["被裁", "被裁了", "被裁员了", "被公司裁了", "被辞退"],
      "max_ratio": 12, "note": "「被公司裁了」把真词「被裁」隔开了，见 thresholds._note" },
    { "name": "押金的各种说法", "queries": ["押金", "押金不退", "房东扣押金", "退押金"] },
    { "name": "减肥的各种说法", "queries": ["减肥", "怎么减肥", "想减肥", "减重"] },
    { "name": "戒烟的各个说法", "queries": ["戒烟", "要不要戒烟", "怎么戒烟", "抽烟"] }
  ]
}
